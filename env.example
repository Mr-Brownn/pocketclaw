# Copy to ~/.pocketclaw/env on the device, fill in, then: chmod 600 ~/.pocketclaw/env
# (pocketclaw-run.sh loads it automatically.) Never commit the filled-in file.

# API key for your OpenAI-compatible LLM provider
LLM_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Numeric chat ID(s) allowed to use the bot, comma-separated. REQUIRED: the bot can run shell commands.
# Message @userinfobot on Telegram to find yours.
TELEGRAM_ALLOWED_CHAT_ID=

# Optional
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
